Class GAR_PlayerClass : PlayerPawn
{
	
	default 
	{
		Player.DisplayName "Gardevoir";
	
		Health 350;
		PainChance 255;
		Player.MaxHealth 350;
		
		Player.ForwardMove 2, 1;
		
		xscale 0.325;
		yscale 0.325;
		
		DamageFactor "Slime", 2.0;
		DamageFactor "Poison", 2.0;
		DamageFactor "PoisonCloud", 2.0;
		DamageFactor "Melee", 0.25;
	}
	
	States
	{
		Spawn:
			GARD BCBA 16;
			Loop;
		See:
			GARD BCBA 6;
			Loop;
		see.SwayForward:
			GARD BCBA 6;
			goto See;
		See.SwayLeft:
			GARD A 6;
			goto See;
		See.SwayRight:
			GARD C 6;
			goto See;
		Pain:
			GARD P 8;
			Goto Spawn;
		Missile:
		Melee:
			GARD F 10;
			goto spawn;
		Death:
			TNT1 A 0 A_SetScale(1);
			PBAL B 16;
			TNT1 A 0 A_StartSound("pokeball/Shake", CHAN_BODY, CHANF_OVERLAP);
			PBAL BFB 4;
			PBAL B 16;
			TNT1 A 0 A_StartSound("pokeball/Shake", CHAN_BODY, CHANF_OVERLAP);
			PBAL BEB 4;
			loop;
	}
}